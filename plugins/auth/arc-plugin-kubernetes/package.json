{
  "name": "@arc/plugin-kubernetes",
  "version": "0.0.0",
  "private": true,
  "description": "Kubernetes auth plugin: verify a ServiceAccount token via the cluster TokenReview API and map it to arc policies. Implements @arc/plugin-sdk's AuthPlugin contract.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node-client.d.ts",
      "import": "./dist/node-client.js",
      "require": "./dist/node-client.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arc/plugin-sdk": "workspace:*",
    "@arc/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
