{
  "name": "@arc/plugin-sign",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for signing arc plugin manifests (ADR-005 Phase 5b). Generates publisher Ed25519 keys, signs manifests pinning artifact SHA-256 + capabilities, verifies manifests against a published pub key.",
  "type": "module",
  "bin": {
    "arc-plugin-sign": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arc/crypto": "workspace:*",
    "@arc/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
