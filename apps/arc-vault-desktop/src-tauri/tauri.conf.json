{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arc-vault",
  "version": "0.0.0",
  "identifier": "app.arcvault.desktop",
  "build": {
    "frontendDist": "../../arc-vault-web/out",
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "pnpm --filter @arc/vault-web dev",
    "beforeBuildCommand": "pnpm --filter @arc/vault-web build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "arc-vault",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3001 https://api.pwnedpasswords.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
