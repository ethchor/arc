{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arc-vault",
  "version": "0.0.0",
  "identifier": "app.arcvault.desktop",
  "build": {
    "frontendDist": "../../arc-vault-web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @arc/vault-web dev",
    "beforeBuildCommand": "pnpm --filter @arc/vault-web build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "arc-vault",
        "width": 420,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3001; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
