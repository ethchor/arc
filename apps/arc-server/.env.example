# arc-vault API configuration.
#
# When DATABASE_URL is set the API uses Postgres (production). When it is unset the API
# falls back to an in-memory sql.js database — dev/test ONLY, data is not persisted.
# DATABASE_URL=postgres://user:password@localhost:5432/arcvault

# Required in production. If unset, a random ephemeral secret is generated at boot (dev only)
# — there is deliberately NO hardcoded fallback secret (see docs/15 §15.4).
# JWT_SECRET=

# Comma-separated allowed CORS origins (defaults to localhost + tauri://localhost).
# CORS_ORIGINS=http://localhost:3000,tauri://localhost

# WebAuthn / passkeys (docs/13). The origin(s) MUST match where the app is actually served,
# or registration/unlock fail with "Unexpected registration response origin". ARC_PASSKEY_ORIGIN
# is comma-separated so one deployment can accept the web app and the desktop (Tauri) shell.
# Defaults (dev): RP_ID=localhost, RP_NAME=arc, ORIGIN=http://localhost:3000,tauri://localhost.
# In production set these to your real domain (e.g. RP_ID=vault.example.com,
# ORIGIN=https://vault.example.com).
# ARC_PASSKEY_RP_ID=localhost
# ARC_PASSKEY_RP_NAME=arc
# ARC_PASSKEY_ORIGIN=http://localhost:3000,tauri://localhost
