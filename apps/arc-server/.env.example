# arc-vault API configuration.
#
# When DATABASE_URL is set the API uses Postgres (production). When it is unset the API
# falls back to an in-memory sql.js database — dev/test ONLY, data is not persisted.
# DATABASE_URL=postgres://user:password@localhost:5432/arcvault

# Required in production. If unset, a random ephemeral secret is generated at boot (dev only)
# — there is deliberately NO hardcoded fallback secret (see docs/15 §15.4).
# JWT_SECRET=

# Comma-separated allowed CORS origins (defaults to localhost + tauri://localhost).
# CORS_ORIGINS=http://localhost:3000,tauri://localhost
