{
  "name": "@arc/server",
  "version": "0.0.0",
  "private": true,
  "description": "Blind ciphertext store: sync authorization + zero-knowledge vault endpoints.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/typeorm.config.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/typeorm.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/typeorm.config.ts"
  },
  "dependencies": {
    "@arc/crypto": "workspace:*",
    "@arc/grants": "workspace:*",
    "@arc/leasing": "workspace:*",
    "@arc/openbao-adapter": "workspace:*",
    "@arc/plugin-sdk": "workspace:*",
    "@arc/secrets-engine": "workspace:*",
    "@arc/types": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@arc/cli": "workspace:*",
    "@arc/plugin-aws": "workspace:*",
    "@arc/plugin-gcp": "workspace:*",
    "@arc/plugin-github": "workspace:*",
    "@arc/sdk": "workspace:*",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
