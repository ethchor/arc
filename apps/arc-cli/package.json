{
  "name": "@arc/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Developer CLI for arc-vault secrets (consumer master-password or machine-identity mode).",
  "type": "module",
  "bin": {
    "arc-vault": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arc/crypto": "workspace:*",
    "@arc/sdk": "workspace:*",
    "@arc/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
