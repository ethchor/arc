{
  "name": "@arc/types",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for TS types/wire shapes shared across arc-crypto, arc-server, arc-sdk, plugins, and the apps. Mostly types; a few small runtime allowlists + guards (e.g. vault-ui) ship dual ESM/CJS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
